
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>HydraFit VAPID Key Generator</title>
<style>
body {
  font-family: Arial, sans-serif;
  background: #fdf2f6;
  padding: 24px;
  color: #442b37;
}
main {
  max-width: 500px;
  margin: 30px auto;
  background: white;
  padding: 24px;
  border-radius: 20px;
}
button {
  background: #be185d;
  color: white;
  border: 0;
  padding: 14px;
  border-radius: 10px;
  width: 100%;
  font-size: 16px;
}
textarea {
  width: 100%;
  height: 75px;
  margin: 10px 0 18px;
  box-sizing: border-box;
  padding: 10px;
  overflow-wrap: anywhere;
}
</style>
</head>
<body>
<main>
<h2>HydraFit VAPID Generator 💧</h2>
<p>Generate your secure Push Notification keys.</p>
<button onclick="generateKeys()">Generate Keys</button>

<h3>Public Key</h3>
<textarea id="publicKey" readonly></textarea>

<h3>Private Key</h3>
<textarea id="privateKey" readonly></textarea>

<p id="status"></p>
</main>

<script>
function base64url(buffer) {
  const bytes = new Uint8Array(buffer);
  let binary = "";
  bytes.forEach(b => binary += String.fromCharCode(b));
  return btoa(binary)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/g, "");
}

async function generateKeys() {
  const status = document.getElementById("status");
  try {
    status.textContent = "Generating...";
    const pair = await crypto.subtle.generateKey(
      { name: "ECDSA", namedCurve: "P-256" },
      true,
      ["sign", "verify"]
    );

    const publicBytes = await crypto.subtle.exportKey(
      "raw", pair.publicKey
    );

    const privateJwk = await crypto.subtle.exportKey(
      "jwk", pair.privateKey
    );

    document.getElementById("publicKey").value =
      base64url(publicBytes);

    document.getElementById("privateKey").value =
      privateJwk.d;

    status.textContent = "Keys generated successfully!";
  } catch (error) {
    status.textContent = "Error: " + error.message;
  }
}
</script>
</body>
</html>
